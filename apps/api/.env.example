PORT=4000
WEB_APP_URL=http://localhost:3000

# Projet Supabase (Settings > API) — utiliser la clé service_role, jamais la clé anon,
# car l'API est la seule frontière de confiance (cf. cahier des charges, section 11).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Espace admin (un seul mot de passe partagé, cf. cahier des charges 7.4).
# Générer le hash avec : npm run hash-password -- "le-mot-de-passe-choisi"
ADMIN_PASSWORD_HASH=
JWT_SECRET=change-moi-avec-une-chaine-aleatoire-longue

# Notification email au couple à chaque nouvelle prière (cahier des charges 7.2).
# Laisser vide pour l'instant : les prières restent enregistrées, seul l'email
# ne partira pas tant que ces variables ne sont pas renseignées.
RESEND_API_KEY=
COUPLE_NOTIFICATION_EMAIL=
NOTIFICATION_FROM_EMAIL=
